{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baxter-industries-production",
  "account_id": "7756735dae2c45923590649fdef82ed8",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "env": {
    "production": {
      "name": "baxter-industries-production",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "baxter-industries.com",
          "zone_id": "ed0ff63153d3def3e15c848515eb4330",
          "custom_domain": true
        }
      ],
      "build": { "command": "npm run build:workers" },
      "assets": {
        "directory": "./.workers-assets/production",
        "binding": "ASSETS",
        "run_worker_first": ["/api", "/api/*"],
        "not_found_handling": "404-page"
      },
      "vars": { "QUOTE_DELIVERY_MODE": "live" }
    },
    "preview": {
      "name": "baxter-industries-preview",
      "workers_dev": true,
      "routes": [],
      "build": { "command": "npm run build:workers:preview" },
      "assets": {
        "directory": "./.workers-assets/preview",
        "binding": "ASSETS",
        "run_worker_first": ["/api", "/api/*"],
        "not_found_handling": "404-page"
      },
      "vars": { "QUOTE_DELIVERY_MODE": "preview" }
    }
  }
}
